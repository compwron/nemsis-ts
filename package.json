{
	"name": "nemsis-ts",
	"version": "0.0.0",
	"description": "Clean-room TypeScript library for reading, writing and validating NEMSIS v3.5 EMS data",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./3.5.0": {
			"types": "./dist/3.5.0.d.ts",
			"import": "./dist/3.5.0.js"
		},
		"./3.5.1": {
			"types": "./dist/3.5.1.d.ts",
			"import": "./dist/3.5.1.js"
		},
		"./validate": {
			"types": "./dist/validate.d.ts",
			"import": "./dist/validate.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./3.5.0/xsd": {
			"types": "./dist/3.5.0/xsd.d.ts",
			"import": "./dist/3.5.0/xsd.js"
		},
		"./3.5.1/xsd": {
			"types": "./dist/3.5.1/xsd.d.ts",
			"import": "./dist/3.5.1/xsd.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test/browser/tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:package": "publint && attw --pack . --profile esm-only",
		"spec:fetch": "node scripts/fetch-spec.ts",
		"codegen": "node scripts/codegen.ts",
		"codegen:check": "node scripts/codegen.ts && git diff --exit-code --stat -- src/generated && test -z \"$(git ls-files --others --exclude-standard -- src/generated)\"",
		"check:bundle": "node scripts/check-bundle.ts",
		"test:coverage": "vitest run --coverage",
		"build:with-xsd": "NEMSIS_BUNDLE_XSD=1 tsdown",
		"test:browser": "vitest run --config vitest.browser.config.ts"
	},
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"playwright": "^1.64.1",
		"publint": "^0.3.25",
		"tsdown": "^0.23.4",
		"typescript": "^7.0.2",
		"vite": "8.3.5",
		"vitest": "^5.1.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/compwron/nemsis-ts.git"
	},
	"keywords": [
		"nemsis",
		"ems",
		"epcr",
		"xml",
		"xsd",
		"schematron"
	],
	"dependencies": {
		"fast-xml-parser": "^5.11.2",
		"saxes": "6.0.0",
		"xmllint-wasm": "^5.3.0"
	}
}
